{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "cache": false
    },
    "type-check": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "serve": {
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "icons:build": {
      "cache": false,
      "outputs": [
        "dist/**"
      ]
    },
    "db:studio": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  },
  "globalEnv": [
    "DATABASE_URL",
    "DATABASE_URL_UNPOOLED",
    "OPENAI_API_KEY",
    "AUTH_RESEND_KEY",
    "DRIIZLE_LOG_ENABLED",
    "SLACK_TOKEN",
    "VERCEL_URL",
    "VERCEL_ENV",
    "AUTH_ENABLED",
    "SUPABASE_PROJECT_ID",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "NEXT_PUBLIC_SUPABASE_COOKIE_DOMAIN",
    "NEXT_PUBLIC_SUPABASE_COOKIE_SECURE",
    "KV_URL",
    "KV_REST_API_READ_ONLY_TOKEN",
    "REDIS_URL",
    "KV_REST_API_TOKEN",
    "KV_REST_API_URL",
    "QSTASH_NEXT_SIGNING_KEY",
    "QSTASH_CURRENT_SIGNING_KEY",
    "QSTASH_URL",
    "QSTASH_TOKEN",
    "NEXT_PUBLIC_POSTHOG_ENABLED",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "NEXT_CONFIG_POSTHOG_PROXY"
  ]
}
