{
  "$schema": "https://v2-7-6.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "cache": false
    },
    "type-check": {
      "cache": false
    },
    "i18n:check": {
      "inputs": ["packages/core/i18n/messages/*.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:https": {
      "cache": false,
      "persistent": true
    },
    "dev:remote": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "serve": {
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "clean:vite": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "icons:build": {
      "cache": false,
      "outputs": ["dist/**"]
    },
    "db:studio": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  },
  "globalEnv": [
    "VITE_ENV",
    "DATABASE_URL",
    "DATABASE_URL_UNPOOLED",
    "OPENAI_API_KEY",
    "DRIZZLE_LOG_ENABLED",
    "VALBOT_SLACK_TOKEN",
    "SUPABASE_PROJECT_ID",
    "SUPABASE_URL",
    "SUPABASE_PUBLISHABLE_KEY",
    "SUPABASE_SECRET_KEY",
    "SUPABASE_COOKIE_DOMAIN",
    "RESEND_SENDING_API_KEY",
    "VITE_POSTHOG_ENABLED",
    "VITE_POSTHOG_KEY",
    "VITE_POSTHOG_HOST",
    "VITE_IMAGEKIT_URL",
    "VITE_STUDIO_URL",
    "VITE_APP_DOMAIN",
    "DOCS_PASSWORD",
    "ADMIN_ALLOWED_EMAILS",
    "ADMIN_COOKIE_DOMAIN",
    "ADMIN_BASE_URL",
    "SLACK_TEAM_ID",
    "VITE_STUDIO_SUPPORT_EMAIL",
    "VITE_R2_PUBLIC_URL",
    "BLOCK_ROBOTS"
  ]
}
