{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", ".output/**"]
    },
    "lint": {
      "cache": false
    },
    "type-check": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:https": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "serve": {
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "clean:vite": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "icons:build": {
      "cache": false,
      "outputs": ["dist/**"]
    },
    "db:studio": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  },
  "globalEnv": [
    "VERCEL_URL",
    "VERCEL_ENV",
    "DATABASE_URL",
    "DATABASE_URL_UNPOOLED",
    "OPENAI_API_KEY",
    "DRIIZLE_LOG_ENABLED",
    "VALBOT_SLACK_TOKEN",
    "SUPABASE_PROJECT_ID",
    "SUPABASE_URL",
    "SUPABASE_PUBLISHABLE_KEY",
    "SUPABASE_SECRET_KEY",
    "SUPABASE_COOKIE_DOMAIN",
    "RESEND_SENDING_API_KEY",
    "VITE_POSTHOG_ENABLED",
    "VITE_POSTHOG_KEY",
    "VITE_POSTHOG_HOST",
    "KV_URL",
    "KV_REST_API_READ_ONLY_TOKEN",
    "REDIS_URL",
    "KV_REST_API_TOKEN",
    "KV_REST_API_URL",
    "QSTASH_NEXT_SIGNING_KEY",
    "QSTASH_CURRENT_SIGNING_KEY",
    "QSTASH_URL",
    "QSTASH_TOKEN"
  ]
}
