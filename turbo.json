{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "cache": false
    },
    "type-check": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "serve": {
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "icons:build": {
      "cache": false,
      "outputs": [
        "dist/**"
      ]
    },
    "db:studio": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  },
  "globalEnv": [
    "VERCEL_URL",
    "VERCEL_ENV",
    "VG_DATABASE_URL",
    "VG_DATABASE_URL_UNPOOLED",
    "VG_OPENAI_API_KEY",
    "VG_DRIIZLE_LOG_ENABLED",
    "VALBOT_SLACK_TOKEN",
    "VG_SUPABASE_PROJECT_ID",
    "VG_SUPABASE_URL",
    "VG_SUPABASE_PUBLISHABLE_KEY",
    "VG_SUPABASE_SECRET_KEY",
    "VG_SUPABASE_COOKIE_DOMAIN",
    "VG_RESEND_SENDING_API_KEY",
    "NEXT_PUBLIC_VG_POSTHOG_ENABLED",
    "NEXT_PUBLIC_VG_POSTHOG_KEY",
    "NEXT_PUBLIC_VG_POSTHOG_HOST",
    "VG_KV_URL",
    "VG_KV_REST_API_READ_ONLY_TOKEN",
    "VG_REDIS_URL",
    "VG_KV_REST_API_TOKEN",
    "VG_KV_REST_API_URL",
    "VG_QSTASH_NEXT_SIGNING_KEY",
    "VG_QSTASH_CURRENT_SIGNING_KEY",
    "VG_QSTASH_URL",
    "VG_QSTASH_TOKEN"
  ]
}
