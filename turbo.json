{
  "$schema": "https://v2-7-6.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "cache": false
    },
    "type-check": {
      "cache": false
    },
    "i18n:check": {
      "inputs": ["packages/core/i18n/messages/*.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:https": {
      "cache": false,
      "persistent": true
    },
    "dev:remote": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "serve": {
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "clean:vite": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "icons:build": {
      "cache": false,
      "outputs": ["dist/**"]
    },
    "db:studio": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  },
  "globalEnv": [
    "VITE_ENV",
    "DATABASE_URL",
    "DRIZZLE_LOG_ENABLED",
    "VALBOT_SLACK_TOKEN",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "BETTER_AUTH_COOKIE_DOMAIN",
    "BETTER_AUTH_COOKIE_PREFIX",
    "BETTER_AUTH_DEV_OTP",
    "RESEND_SENDING_API_KEY",
    "VITE_POSTHOG_ENABLED",
    "VITE_POSTHOG_KEY",
    "VITE_POSTHOG_HOST",
    "VITE_IMAGEKIT_URL",
    "VITE_STUDIO_URL",
    "VITE_APP_DOMAIN",
    "DOCS_PASSWORD",
    "ADMIN_ALLOWED_EMAILS",
    "ADMIN_COOKIE_DOMAIN",
    "ADMIN_BASE_URL",
    "SLACK_CLIENT_ID",
    "SLACK_CLIENT_SECRET",
    "SLACK_TEAM_ID",
    "VITE_STUDIO_SUPPORT_EMAIL",
    "VITE_R2_PUBLIC_URL",
    "VITE_IMAGE_PROVIDER",
    "BLOCK_ROBOTS",
    "MAINTENANCE_FORCE_STUDIO",
    "MAINTENANCE_FORCE_APP"
  ]
}
