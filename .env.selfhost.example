# Copy to .env.selfhost and replace values for self-host deploy setup.
# This file can feed:
# - pnpm wrangler-config generate <target> --target-env <dev|prod> --env-file .env.selfhost
# - pnpm cloudflare-secrets push <target|all> --target-env <dev|prod> --env-file .env.selfhost

TARGET_ENV=prod

# Cloudflare deploy credentials. Prefer shell or CI secrets for real values.
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token

# Shared Cloudflare resource IDs and names. Create these in your Cloudflare account.
CF_AUTH_KV_ID=replace-with-auth-kv-id
CF_TOUR_DATA_KV_ID=replace-with-tour-data-kv-id
CF_MAINTENANCE_KV_ID=replace-with-maintenance-kv-id
CF_LINKS_KV_ID=replace-with-links-kv-id
CF_R2_BUCKET_NAME=replace-with-r2-bucket-name
CF_R2_JURISDICTION=eu

# Worker names.
APP_WORKER_NAME=example-valguide-app
STUDIO_WORKER_NAME=example-valguide-studio
ADMIN_WORKER_NAME=example-valguide-admin
LINKS_WORKER_NAME=example-valguide-links
WWW_WORKER_NAME=example-valguide-www
DOCS_WORKER_NAME=example-valguide-docs
STORYBOOK_WORKER_NAME=example-valguide-storybook
IMAGE_GUARD_WORKER_NAME=example-valguide-image-guard
POSTHOG_PROXY_WORKER_NAME=example-valguide-posthog-proxy

# Routes. Comma-separate multiple routes. Use pattern|zone=example.com for zone_name routes.
APP_ROUTES=app.example.com
STUDIO_ROUTES=studio.example.com
ADMIN_ROUTES=admin.example.com
LINKS_ROUTES=links.example.com,l.example.com
WWW_ROUTES=www.example.com
DOCS_ROUTES=docs.example.com
STORYBOOK_ROUTES=storybook.example.com
IMAGE_GUARD_ROUTES=assets.example.com/i/*|zone=example.com,assets.example.com/v/*|zone=example.com
POSTHOG_PROXY_ROUTES=e.example.com

# Public build/runtime URLs.
NODE_ENV=production
VITE_ENV=prod
APP_BASE_URL=https://app.example.com
LINKS_BASE_URL=https://links.example.com
ADMIN_BASE_URL=https://admin.example.com
ADMIN_AUTH_MODE=credentials
ADMIN_COOKIE_DOMAIN=admin.example.com
VITE_STUDIO_URL=https://studio.example.com
VITE_APP_DOMAIN=app.example.com
VITE_PRIVACY_POLICY_URL=https://www.example.com/privacy-policy
VITE_TERMS_OF_SERVICE_URL=https://www.example.com/terms-of-service
VITE_R2_PUBLIC_URL=https://assets.example.com
BLOCK_ROBOTS=false

# Auth runtime config.
BETTER_AUTH_URL=https://studio.example.com
BETTER_AUTH_TRUSTED_ORIGINS=https://studio.example.com,https://app.example.com
BETTER_AUTH_COOKIE_DOMAIN=.example.com
BETTER_AUTH_COOKIE_PREFIX=valguide-auth

# Optional analytics and integrations. Public PostHog values are shipped to clients.
VITE_POSTHOG_ENABLED=false
POSTHOG_PROJECT_KEY=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://e.example.com
LINEAR_FEEDBACK_TEAM_ID=
LINEAR_FEEDBACK_LABEL_ID=

# Runtime secrets for explicit Cloudflare Worker secret push only.
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>
BETTER_AUTH_SECRET=replace-with-secret
RESEND_SENDING_API_KEY=replace-with-resend-api-key
ADMIN_ALLOWED_EMAILS=admin@example.com
VALBOT_SLACK_TOKEN=

# Optional hosted/team auth for the admin app. Self-hosted deployments can leave these empty
# when ADMIN_AUTH_MODE=credentials.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_TEAM_ID=
LINEAR_API_KEY=
DOCS_PASSWORD=replace-with-docs-password

# Optional channel names.
USERS_SLACK_CHANNEL=users
MAINTENANCE_SLACK_CHANNEL=maintenance
STUDIO_EVENTS_SLACK_CHANNEL=studio-events
STUDIO_FEEDBACK_SLACK_CHANNEL=studio-feedback
STUDIO_PERFORMANCE_LOG_ENABLED=false
