{
  "$schema": "https://biomejs.dev/schemas/2.3.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedImports": "warn",
        "noUnusedVariables": "warn",
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useImportType": "warn",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "next/link": "Please import Link from `@tanstack/react-router` instead.",
              "next/navigation": "Please import from `@tanstack/react-router` instead. Use `useRouter`, `useLocation`, `Link` from TanStack Router."
            }
          }
        }
      },
      "a11y": {
        "useAltText": "warn",
        "useButtonType": "warn"
      },
      "nursery": {
        "noJsxLiterals": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.stories.tsx", "**/*.stories.ts"],
      "linter": {
        "rules": {
          "nursery": {
            "noJsxLiterals": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/transactional/**/*.tsx", "packages/transactional/**/*.ts"],
      "linter": {
        "rules": {
          "nursery": {
            "noJsxLiterals": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/core/ui/**/*.tsx", "packages/core/ui/**/*.ts"],
      "linter": {
        "rules": {
          "nursery": {
            "noJsxLiterals": "off"
          },
          "a11y": {
            "useSemanticElements": "warn",
            "useFocusableInteractive": "warn",
            "useAriaPropsForRole": "warn"
          }
        }
      }
    },
    {
      "includes": ["packages/core/scripts/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "**",
      "!**/.history",
      "!**/.idea",
      "!**/.next",
      "!**/.turbo",
      "!**/.vercel",
      "!**/dist",
      "!**/node_modules",
      "!**/storybook-static",
      "!**/*.config.js",
      "!**/*.config.mjs",
      "!**/*.config.ts",
      "!**/drizzle.config.ts",
      "!**/postcss.config.mjs",
      "!**/tailwind.config.ts",
      "!**/growth",
      "!**/*.css",
      "!**/routeTree.gen.ts",
      "!apps/storybook/.storybook/__mocks__"
    ]
  }
}
