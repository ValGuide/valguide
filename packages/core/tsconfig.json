{
  "extends": "@valguide/typescript-config/start.json",
  "compilerOptions": {
    "types": ["vite/client", "jest", "node"],
    "paths": {
      "@valguide/core/*": ["./*"],
      "@valguide/ui/*": ["./ui/*"],
      "@valguide/i18n/*": ["./i18n/*"],
      "@valguide/features/*": ["./features/*"],
      "@valguide/slack/*": ["./slack/*"],
      "@valguide/linear/*": ["./linear/*"],
      "@valguide/icons/*": ["../icons/dist/*"],
      "@valguide/logger": ["../logger"]
    }
  },
  "include": ["env/env.d.ts", "i18n/global.d.ts", "platform/providers/cloudflare/workers.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
