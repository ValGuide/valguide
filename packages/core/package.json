  },
  "dependencies": {
    "@auth/pg-adapter": "^1.7.0",
    "@valguide/logger": "workspace:*",
    "@faker-js/faker": "^9.2.0",
    "@neondatabase/serverless": "^0.9.5",
    "drizzle-orm": "^0.35.1",
    "nanoid": "^5.0.7",
