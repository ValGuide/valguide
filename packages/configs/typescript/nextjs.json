{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Next.js",
  "extends": "./base.json",
  "compilerOptions": {
    "baseUrl": "../../",
    "paths": {
      "@/*": [
        "."
      ],
      "@valguide/features/*": [
        "packages/core/features/*"
      ],
      "@valguide/slack/*": [
        "packages/core/slack/*"
      ],
      "@valguide/ui/*": [
        "packages/core/ui/*"
      ],
      "@valguide/supabase/*": [
        "packages/core/supabase/*"
      ],
      "@valguide/i18n/*": [
        "packages/core/i18n/*"
      ],
      "@valguide/core/*": [
        "packages/core/*"
      ],
      "@valguide/icons/*": [
        "packages/icons/dist/*"
      ],
      "@valguide/logger/*": [
        "packages/logger/src/*"
      ],
      "@valguide/logger": [
        "packages/logger"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "jsx": "preserve",
    "noEmit": true
  }
}
