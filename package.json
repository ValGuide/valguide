{
  "name": "@valguide/turbo",
  "private": true,
  "scripts": {
    "env:load": "pnpm dlx tsx ./scripts/load-env.ts",
    "env:merge": "pnpm dlx tsx ./scripts/merge-env.ts",
    "env:push": "pnpm dlx tsx ./scripts/push-to-vercel.ts",
    "env:clear": "pnpm dlx tsx ./scripts/clear-vercel-env.ts",
    "prepare": "husky",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "biome check .",
    "lint:error": "biome check . --diagnostic-level=error",
    "lint:fix": "biome check --write .",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "i18n:check": "pnpm --filter @valguide/core i18n:check",
    "i18n:unused": "pnpm dlx tsx scripts/find-unused-i18n-keys.ts",
    "i18n:prune": "pnpm dlx tsx scripts/remove-unused-i18n-keys.ts",
    "clean": "turbo clean --parallel && rm -rf node_modules pnpm-lock.yaml .turbo",
    "clean:vite": "turbo run clean:vite --parallel",
    "clean:install": "pnpm clean && pnpm install",
    "format": "biome format --write .",
    "secrets:hide": "sh scripts/secrets-hide.sh",
    "secrets:show": "sh scripts/secrets-show.sh",
    "core:type-check": "pnpm turbo run type-check --filter ./packages/core",
    "admin:dev": "pnpm caddy:ensure && (sleep 5 && open https://admin-local.dev) & pnpm env:load turbo run dev --filter ./apps/admin",
    "admin:start": "pnpm env:load turbo run start --filter ./apps/admin",
    "admin:build": "pnpm env:load turbo run build --filter ./apps/admin",
    "admin:preview": "pnpm env:load turbo run preview --filter ./apps/admin",
    "admin:type-check": "pnpm turbo run type-check --filter ./apps/admin",
    "api:dev": "pnpm env:load turbo run dev --filter ./apps/api -- --port 3000",
    "api:start": "pnpm env:load turbo run start --filter ./apps/api --",
    "api:build": "pnpm env:load turbo run build --filter ./apps/api --",
    "api:docker": "docker build -t valguide-api -f ./apps/api/Dockerfile .",
    "api:docker:run": "docker run -p 3000:3000 valguide-api",
    "app:dev": "pnpm caddy:ensure && (sleep 5 && open https://app.local.dev) & pnpm env:load turbo run dev --filter ./apps/app",
    "app:start": "pnpm env:load turbo run start --filter ./apps/app",
    "app:build": "pnpm env:load turbo run build --filter ./apps/app",
    "app:preview": "pnpm env:load turbo run preview --filter ./apps/app",
    "app:type-check": "pnpm turbo run type-check --filter ./apps/app",
    "studio:dev": "pnpm caddy:ensure && (sleep 5 && open https://studio.local.dev) & pnpm env:load turbo run dev --filter ./apps/studio",
    "studio:start": "pnpm env:load turbo run start --filter ./apps/studio",
    "studio:build": "pnpm env:load turbo run build --filter ./apps/studio",
    "studio:preview": "pnpm env:load turbo run preview --filter ./apps/studio",
    "studio:type-check": "pnpm turbo run type-check --filter ./apps/studio",
    "www:dev": "pnpm caddy:ensure && (sleep 5 && open https://www.local.dev) & pnpm env:load turbo run dev --filter ./apps/www",
    "www:start": "pnpm env:load turbo run start --filter ./apps/www",
    "www:build": "pnpm env:load turbo run build --filter ./apps/www",
    "www:preview": "pnpm env:load turbo run preview --filter ./apps/www",
    "www:type-check": "pnpm turbo run type-check --filter ./apps/www",
    "links:dev": "pnpm caddy:ensure && (sleep 5 && open https://links.local.dev) & pnpm env:load turbo run dev --filter ./apps/links",
    "links:start": "pnpm env:load turbo run start --filter ./apps/links",
    "links:build": "pnpm env:load turbo run build --filter ./apps/links",
    "links:preview": "pnpm env:load turbo run preview --filter ./apps/links",
    "links:type-check": "pnpm turbo run type-check --filter ./apps/links",
    "docs:dev": "pnpm caddy:ensure && (sleep 5 && open https://docs.local.dev) & pnpm env:load turbo run dev --filter ./apps/docs",
    "docs:start": "pnpm env:load turbo run start --filter ./apps/docs",
    "docs:build": "pnpm env:load turbo run build --filter ./apps/docs",
    "docs:preview": "pnpm env:load turbo run preview --filter ./apps/docs",
    "docs:type-check": "pnpm turbo run type-check --filter ./apps/docs",
    "db:generate": "turbo run db:generate --",
    "db:migrate": "turbo run db:migrate --",
    "db:studio": "turbo run db:studio --",
    "madge:circular": "pnpm dlx madge -c --extensions ts,tsx,js,jsx .",
    "storybook:clean": "pnpm --filter @valguide/storybook clean",
    "storybook:build": "pnpm --filter @valguide/storybook build",
    "storybook:serve": "pnpm --filter @valguide/storybook serve",
    "storybook:dev": "pnpm caddy:ensure && (sleep 5 && open https://storybook.local.dev) & turbo run dev --filter ./apps/storybook",
    "caddy": "caddy run --config Caddyfile.local",
    "caddy:ensure": "sh scripts/ensure-caddy.sh",
    "icons:build": "turbo run build --filter ./packages/icons",
    "supabase:link": "supabase link --project-ref $SUPABASE_PROJECT_ID",
    "supabase:link:dev": "pnpm env:load --sb:dev pnpm supabase:link",
    "supabase:link:prod": "pnpm env:load --sb:prod pnpm supabase:link",
    "supabase:functions:deploy": "supabase functions deploy --project-ref $SUPABASE_PROJECT_ID",
    "supabase:functions:deploy:dev": "pnpm env:load --sb:dev --rs:dev pnpm supabase:functions:deploy",
    "supabase:functions:deploy:prod": "pnpm env:load --sb:prod --rs:prod pnpm supabase:functions:deploy",
    "supabase:secrets:set": "supabase secrets set RESEND_SENDING_API_KEY=$RESEND_SENDING_API_KEY SEND_EMAIL_HOOK_SECRET=$SEND_EMAIL_HOOK_SECRET --project-ref $SUPABASE_PROJECT_ID",
    "supabase:secrets:set:dev": "pnpm env:load --sb:dev --rs:dev pnpm supabase:secrets:set",
    "supabase:secrets:set:prod": "pnpm env:load --sb:prod --rs:prod pnpm supabase:secrets:set",
    "seed:dev": "pnpm env:load --sb:dev pnpm dlx tsx scripts/seed-studio.ts",
    "seed:prod": "pnpm env:load --sb:prod pnpm dlx tsx scripts/seed-studio.ts",
    "resend:sync": "pnpm env:load pnpm --filter @valguide/email sync-templates",
    "email:dev": "pnpm --filter @valguide/email dev",
    "workspace:dev": "pnpm caddy:ensure && (sleep 5 && for u in studio.local.dev admin-local.dev storybook.local.dev; do open https://$u; done) & pnpm env:load turbo run dev --filter ./apps/studio --filter ./apps/admin --filter ./apps/storybook"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.0",
    "@dotenvx/dotenvx": "^1.22.0",
    "@faker-js/faker": "^9.9.0",
    "@supabase/supabase-js": "^2.93.3",
    "@types/node": "^22.13.1",
    "@valguide/test-config": "workspace:*",
    "@valguide/typescript-config": "workspace:*",
    "baseline-browser-mapping": "^2.9.18",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^12.0.3",
    "drizzle-orm": "^0.43.1",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "playwright": "^1.58.0",
    "postgres": "^3.4.8",
    "ts-morph": "^27.0.2",
    "turbo": "2.8.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.2",
      "@types/react-dom": "19.2.2",
      "uuid": "^9.0.0"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "wallaby": {
    "trace": true
  },
  "dependencies": {
    "@tanstack/react-form": "^1.27.7"
  }
}
