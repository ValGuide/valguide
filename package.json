{
  "name": "@valguide/workspace",
  "private": true,
  "scripts": {
    "val": "node scripts/val.mjs",
    "env:load": "node ./scripts/load-env.mjs",
    "env:merge": "pnpm dlx tsx ./scripts/merge-env.ts",
    "env:push:cf": "pnpm dlx tsx ./scripts/push-to-cloudflare.ts",
    "cloudflare:infra:init": "cd infra/cloudflare && tofu init",
    "cloudflare:infra:workspace:dev": "cd infra/cloudflare && tofu workspace select dev || tofu workspace new dev",
    "cloudflare:infra:workspace:prod": "cd infra/cloudflare && tofu workspace select prod || tofu workspace new prod",
    "cloudflare:infra:plan:dev": "node_modules/.bin/dotenvx run --env-file=.secrets/.env.defaults --env-file=.secrets/.env.cloudflare.dev -- sh -c 'cd infra/cloudflare && tofu workspace select dev && tofu plan -var-file=environments/dev.tfvars'",
    "cloudflare:infra:plan:prod": "node_modules/.bin/dotenvx run --env-file=.secrets/.env.defaults --env-file=.secrets/.env.cloudflare.prod -- sh -c 'cd infra/cloudflare && tofu workspace select prod && tofu plan -var-file=environments/prod.tfvars'",
    "cloudflare:infra:apply:dev": "node_modules/.bin/dotenvx run --env-file=.secrets/.env.defaults --env-file=.secrets/.env.cloudflare.dev -- sh -c 'cd infra/cloudflare && tofu workspace select dev && tofu apply -var-file=environments/dev.tfvars'",
    "cloudflare:infra:apply:prod": "node_modules/.bin/dotenvx run --env-file=.secrets/.env.defaults --env-file=.secrets/.env.cloudflare.prod -- sh -c 'cd infra/cloudflare && tofu workspace select prod && tofu apply -var-file=environments/prod.tfvars'",
    "prepare": "husky",
    "build": "nx run-many -t build",
    "dev": "nx run-many -t dev",
    "dev:select": "sh scripts/dev.sh",
    "dev:select:local": "sh scripts/dev.sh --no-remote",
    "lint": "biome check .",
    "lint:error": "biome check . --diagnostic-level=error",
    "lint:fix": "biome check --write .",
    "test": "nx run-many -p @valguide/core,@valguide/studio,@valguide/admin,@valguide/links,@valguide/app,@valguide/www,@valguide/github -t test --parallel=7",
    "type-check": "pnpm exec tsc --noEmit -p tsconfig.json && nx run-many -t type-check",
    "i18n:check": "pnpm dlx tsx scripts/validate-locales.ts",
    "i18n:unused": "pnpm dlx tsx scripts/find-unused-i18n-keys.ts",
    "i18n:prune": "pnpm dlx tsx scripts/remove-unused-i18n-keys.ts",
    "clean": "nx run-many -t clean --parallel=3 && rm -rf node_modules pnpm-lock.yaml .nx",
    "clean:vite": "nx run-many -t clean-vite --parallel=3",
    "clean:install": "pnpm clean && pnpm install",
    "format": "biome format --write .",
    "secrets:hide": "bash scripts/secrets-hide.sh",
    "secrets:show": "bash scripts/secrets-show.sh",
    "submodules": "bash scripts/submodules.sh",
    "submodules:load": "bash scripts/submodules.sh load",
    "submodules:unload": "bash scripts/submodules.sh unload",
    "submodules:status": "bash scripts/submodules.sh status",
    "core:type-check": "nx run @valguide/core:type-check",
    "admin:dev": "./val dev admin",
    "admin:dev:local": "./val dev admin --no-remote",
    "admin:build": "pnpm env:load nx run @valguide/admin:build",
    "admin:build:analyse": "pnpm env:load nx run '@valguide/admin:build:analyse'",
    "admin:preview": "pnpm caddy:ensure && (sh scripts/open-when-ready.sh https://admin-local.dev) & pnpm env:load nx run @valguide/admin:preview",
    "admin:build:preview": "pnpm admin:build && pnpm admin:preview",
    "admin:type-check": "nx run @valguide/admin:type-check",
    "app:dev": "./val dev app",
    "app:dev:local": "./val dev app --no-remote",
    "app:build": "pnpm env:load nx run @valguide/app:build",
    "app:build:analyse": "pnpm env:load nx run '@valguide/app:build:analyse'",
    "app:preview": "pnpm caddy:ensure && (sh scripts/open-when-ready.sh https://app.local.dev) & pnpm env:load nx run @valguide/app:preview",
    "app:build:preview": "pnpm app:build && pnpm app:preview",
    "app:type-check": "nx run @valguide/app:type-check",
    "studio:dev": "./val dev studio",
    "studio:dev:local": "./val dev studio --no-remote",
    "studio:build": "pnpm env:load nx run @valguide/studio:build",
    "studio:build:analyse": "pnpm env:load nx run '@valguide/studio:build:analyse'",
    "studio:preview": "pnpm caddy:ensure && (sh scripts/open-when-ready.sh https://studio.local.dev) & pnpm env:load nx run @valguide/studio:preview",
    "studio:build:preview": "pnpm studio:build && pnpm studio:preview",
    "studio:agent:start": "node scripts/studio-agent/start.mjs",
    "studio:agent:verify": "node scripts/studio-agent/verify.mjs",
    "studio:agent:flow-snapshot": "node scripts/studio-agent/repros/studio-flow-snapshot.mjs",
    "studio:agent:vg-85": "node scripts/studio-agent/repros/vg-85.mjs",
    "studio:type-check": "nx run @valguide/studio:type-check",
    "www:dev": "./val dev www",
    "www:dev:local": "./val dev www --no-remote",
    "www:build": "pnpm env:load nx run @valguide/www:build",
    "www:build:analyse": "pnpm env:load nx run '@valguide/www:build:analyse'",
    "www:preview": "pnpm caddy:ensure && (sh scripts/open-when-ready.sh https://www.local.dev) & pnpm env:load nx run @valguide/www:preview",
    "www:build:preview": "pnpm www:build && pnpm www:preview",
    "www:type-check": "nx run @valguide/www:type-check",
    "links:dev": "./val dev links",
    "links:dev:local": "./val dev links --no-remote",
    "links:build": "pnpm env:load nx run @valguide/links:build",
    "links:build:analyse": "pnpm env:load nx run '@valguide/links:build:analyse'",
    "links:preview": "pnpm caddy:ensure && (sh scripts/open-when-ready.sh https://links.local.dev) & pnpm env:load nx run @valguide/links:preview",
    "links:build:preview": "pnpm links:build && pnpm links:preview",
    "links:type-check": "nx run @valguide/links:type-check",
    "docs:dev": "./val dev docs",
    "docs:dev:local": "./val dev docs --no-remote",
    "docs:build": "pnpm env:load nx run @valguide/docs:build",
    "docs:build:analyse": "pnpm env:load nx run '@valguide/docs:build:analyse'",
    "docs:preview": "pnpm caddy:ensure && (sh scripts/open-when-ready.sh https://docs.local.dev) & pnpm env:load nx run @valguide/docs:preview",
    "docs:build:preview": "pnpm docs:build && pnpm docs:preview",
    "docs:type-check": "nx run @valguide/docs:type-check",
    "db:generate": "nx run '@valguide/core:db:generate'",
    "db:migrate": "nx run '@valguide/core:db:migrate'",
    "db:studio": "nx run '@valguide/core:db:studio'",
    "db:setup-local": "sh scripts/setup-local-postgres.sh",
    "db:status-local": "sh scripts/status-local-postgres.sh",
    "storybook:clean": "nx run @valguide/storybook:clean",
    "storybook:build": "nx run @valguide/storybook:build",
    "storybook:serve": "nx run @valguide/storybook:serve",
    "storybook:dev": "./val dev storybook",
    "storybook:wrangler:dev": "(sh scripts/open-when-ready.sh http://localhost:8787) & nx run @valguide/storybook:dev & pnpm --filter @valguide/storybook worker:dev",
    "caddy": "caddy run --config Caddyfile.local",
    "caddy:ensure": "sh scripts/ensure-caddy.sh",
    "icons:build": "nx run @valguide/icons:build",
    "seed:dev": "pnpm env:load --db:dev pnpm dlx tsx scripts/seed-studio/main.ts",
    "seed:prod": "pnpm env:load --db:prod pnpm dlx tsx scripts/seed-studio/main.ts",
    "kv:backfill:dev": "pnpm env:load --db:dev pnpm dlx tsx scripts/kv-backfill.ts",
    "kv:backfill:prod": "pnpm env:load --db:prod pnpm dlx tsx scripts/kv-backfill.ts",
    "resend:sync": "pnpm env:load pnpm --filter @valguide/email sync-templates",
    "email:dev": "pnpm --filter @valguide/email dev",
    "admin:deploy": "pnpm env:load pnpm --filter @valguide/admin deploy",
    "admin:deploy:dev": "pnpm env:load pnpm --filter @valguide/admin deploy:dev",
    "app:deploy": "pnpm env:load pnpm --filter @valguide/app deploy",
    "app:deploy:dev": "pnpm env:load pnpm --filter @valguide/app deploy:dev",
    "studio:deploy": "pnpm env:load pnpm --filter @valguide/studio deploy",
    "studio:deploy:dev": "pnpm env:load pnpm --filter @valguide/studio deploy:dev",
    "www:deploy": "pnpm env:load pnpm --filter @valguide/www deploy",
    "www:deploy:dev": "pnpm env:load pnpm --filter @valguide/www deploy:dev",
    "links:deploy": "pnpm env:load pnpm --filter @valguide/links deploy",
    "links:deploy:dev": "pnpm env:load pnpm --filter @valguide/links deploy:dev",
    "docs:deploy": "pnpm env:load pnpm --filter @valguide/docs deploy",
    "docs:deploy:dev": "pnpm env:load pnpm --filter @valguide/docs deploy:dev",
    "storybook:deploy": "pnpm --filter @valguide/storybook deploy",
    "storybook:deploy:dev": "pnpm --filter @valguide/storybook deploy:dev",
    "workspace:dev": "./val dev workspace",
    "gh:actions": "open https://github.com/valguide/valguide/actions"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@dotenvx/dotenvx": "^1.54.1",
    "@faker-js/faker": "^9.9.0",
    "@types/node": "^22.13.1",
    "@valguide/test-config": "workspace:*",
    "@valguide/typescript-config": "workspace:*",
    "baseline-browser-mapping": "^2.10.0",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "dotenv": "^17.3.1",
    "dotenv-expand": "^12.0.3",
    "drizzle-orm": "^0.45.1",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "nx": "22.6.5",
    "playwright": "^1.58.0",
    "postgres": "^3.4.8",
    "rollup-plugin-visualizer": "^7.0.1",
    "ts-morph": "^27.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.2",
      "@types/react-dom": "19.2.2",
      "uuid": "^9.0.0"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "wallaby": {
    "trace": true
  },
  "dependencies": {
    "@tanstack/react-form": "^1.28.4"
  }
}
