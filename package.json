{
  "name": "valguide",
  "private": true,
  "scripts": {
    "val": "node scripts/val.mjs",
    "val:setup": "node scripts/setup-val.mjs",
    "prepare": "husky",
    "build": "nx run-many -t build",
    "dev": "nx run-many -t dev",
    "dev:select": "sh scripts/dev.sh",
    "dev:select:local": "sh scripts/dev.sh --no-remote",
    "secrets:check": "node -- scripts/check-secrets.mjs",
    "secrets:test": "node -- scripts/check-secrets.test.mjs",
    "lint": "biome check .",
    "lint:error": "biome check . --diagnostic-level=error",
    "lint:fix": "biome check --write .",
    "test": "nx run-many -p @valguide/core,@valguide/studio,@valguide/admin,@valguide/links,@valguide/app,@valguide/www -t test --parallel=6",
    "type-check": "pnpm exec tsc --noEmit -p tsconfig.json && nx run-many -t type-check --exclude=valguide",
    "i18n:check": "pnpm dlx tsx scripts/validate-locales.ts",
    "i18n:unused": "pnpm dlx tsx scripts/find-unused-i18n-keys.ts",
    "i18n:prune": "pnpm dlx tsx scripts/remove-unused-i18n-keys.ts",
    "knip": "knip",
    "knip:ci": "knip --production --reporter compact --max-issues 0",
    "knip:production": "knip --production",
    "knip:strict": "knip --strict",
    "knip:manual": "knip --include files,dependencies,unlisted,unresolved,exports,types,duplicates",
    "knip:deps": "knip --dependencies",
    "knip:files": "knip --files",
    "knip:exports": "knip --exports",
    "knip:debug": "knip --debug --trace",
    "knip:fix": "knip --fix --fix-type dependencies,exports,types --format",
    "knip:fix:files": "knip --files --fix --fix-type files --allow-remove-files --format",
    "clean": "nx run-many -t clean --parallel=3 && rm -rf node_modules pnpm-lock.yaml .nx",
    "clean:vite": "nx run-many -t clean-vite --parallel=3",
    "clean:install": "pnpm clean && pnpm install",
    "format": "biome format --write .",
    "core:type-check": "nx run @valguide/core:type-check",
    "admin:dev": "./val dev admin",
    "admin:dev:local": "./val dev admin --no-remote",
    "admin:build": "nx run @valguide/admin:build",
    "admin:build:analyse": "nx run '@valguide/admin:build:analyse'",
    "admin:preview": "sh scripts/preview.sh admin",
    "admin:build:preview": "pnpm admin:build && pnpm admin:preview",
    "admin:type-check": "nx run @valguide/admin:type-check",
    "app:dev": "./val dev app",
    "app:dev:local": "./val dev app --no-remote",
    "app:build": "nx run @valguide/app:build",
    "app:build:analyse": "nx run '@valguide/app:build:analyse'",
    "app:preview": "sh scripts/preview.sh app",
    "app:build:preview": "pnpm app:build && pnpm app:preview",
    "app:type-check": "nx run @valguide/app:type-check",
    "studio:dev": "./val dev studio",
    "studio:dev:local": "./val dev studio --no-remote",
    "studio:build": "nx run @valguide/studio:build",
    "studio:build:analyse": "nx run '@valguide/studio:build:analyse'",
    "studio:preview": "sh scripts/preview.sh studio",
    "studio:build:preview": "pnpm studio:build && pnpm studio:preview",
    "studio:type-check": "nx run @valguide/studio:type-check",
    "www:dev": "./val dev www",
    "www:dev:local": "./val dev www --no-remote",
    "www:build": "nx run @valguide/www:build",
    "www:build:analyse": "nx run '@valguide/www:build:analyse'",
    "www:preview": "sh scripts/preview.sh www",
    "www:build:preview": "pnpm www:build && pnpm www:preview",
    "www:type-check": "nx run @valguide/www:type-check",
    "links:dev": "./val dev links",
    "links:dev:local": "./val dev links --no-remote",
    "links:build": "nx run @valguide/links:build",
    "links:build:analyse": "nx run '@valguide/links:build:analyse'",
    "links:preview": "sh scripts/preview.sh links",
    "links:build:preview": "pnpm links:build && pnpm links:preview",
    "links:type-check": "nx run @valguide/links:type-check",
    "docs:dev": "./val dev docs",
    "docs:dev:local": "./val dev docs --no-remote",
    "docs:build": "nx run @valguide/docs:build",
    "docs:build:analyse": "nx run '@valguide/docs:build:analyse'",
    "docs:preview": "sh scripts/preview.sh docs",
    "docs:build:preview": "pnpm docs:build && pnpm docs:preview",
    "docs:type-check": "nx run @valguide/docs:type-check",
    "db:generate": "nx run '@valguide/core:db:generate'",
    "db:migrate": "nx run '@valguide/core:db:migrate'",
    "db:studio": "nx run '@valguide/core:db:studio'",
    "db:setup-local": "sh scripts/setup-local-postgres.sh",
    "db:status-local": "sh scripts/status-local-postgres.sh",
    "storybook:clean": "nx run @valguide/storybook:clean",
    "storybook:build": "nx run @valguide/storybook:build",
    "storybook:serve": "nx run @valguide/storybook:serve",
    "storybook:dev": "./val dev storybook",
    "storybook:wrangler:dev": "(sh scripts/open-when-ready.sh http://localhost:8787) & nx run @valguide/storybook:dev & pnpm --filter @valguide/storybook worker:dev",
    "caddy": "caddy run --config Caddyfile.local",
    "caddy:ensure": "nx run @valguide/local-proxy:dev",
    "icons:build": "nx run @valguide/icons:build",
    "resend:sync": "pnpm --filter @valguide/email sync-templates",
    "email:dev": "pnpm --filter @valguide/email dev",
    "wrangler-config": "node -- scripts/wrangler-config/cli.mjs",
    "wrangler-config:test": "node -- scripts/wrangler-config/cli.test.mjs",
    "cloudflare-secrets": "node -- scripts/cloudflare-secrets/push.mjs",
    "cloudflare-secrets:test": "node -- scripts/cloudflare-secrets/push.test.mjs",
    "admin:deploy": "pnpm --filter @valguide/admin deploy",
    "admin:deploy:dev": "pnpm --filter @valguide/admin deploy:dev",
    "app:deploy": "pnpm --filter @valguide/app deploy",
    "app:deploy:dev": "pnpm --filter @valguide/app deploy:dev",
    "studio:deploy": "pnpm --filter @valguide/studio deploy",
    "studio:deploy:dev": "pnpm --filter @valguide/studio deploy:dev",
    "www:deploy": "pnpm --filter @valguide/www deploy",
    "www:deploy:dev": "pnpm --filter @valguide/www deploy:dev",
    "links:deploy": "pnpm --filter @valguide/links deploy",
    "links:deploy:dev": "pnpm --filter @valguide/links deploy:dev",
    "docs:deploy": "pnpm --filter @valguide/docs run deploy",
    "docs:deploy:dev": "pnpm --filter @valguide/docs run deploy:dev",
    "storybook:deploy": "pnpm --filter @valguide/storybook deploy",
    "storybook:deploy:dev": "pnpm --filter @valguide/storybook deploy:dev",
    "gh:actions": "open https://github.com/valguide/valguide/actions"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/node": "^22.13.1",
    "@valguide/typescript-config": "workspace:*",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "drizzle-orm": "^0.45.1",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "knip": "^6.16.1",
    "lint-staged": "^15.2.10",
    "nx": "22.6.5",
    "postgres": "^3.4.8",
    "rollup-plugin-visualizer": "^7.0.1",
    "ts-morph": "^27.0.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.2",
      "@types/react-dom": "19.2.2",
      "uuid": "^9.0.0"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "wallaby": {
    "trace": true
  }
}
