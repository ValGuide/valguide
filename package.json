{
  "name": "@valguide/turbo",
  "private": true,
  "scripts": {
    "env:load": "pnpm dlx tsx ./.scripts/load-env.ts",
    "prepare": "husky",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "clean": "turbo clean --parallel && rm -rf node_modules pnpm-lock.yaml .turbo",
    "clean:install": "pnpm clean && pnpm install",
    "format": "prettier --write \"**/*.{html,js,jsx,ts,tsx}\"",
    "secrets:hide": "sh .scripts/secrets-hide.sh",
    "secrets:show": "sh .scripts/secrets-show.sh",
    "visit:dev": "pnpm env:load turbo run dev --filter ./apps/visit --",
    "visit:build": "pnpm env:load turbo run build --filter ./apps/visit --",
    "visit:start": "pnpm env:load turbo run start --filter ./apps/visit --",
    "studio:dev": "pnpm env:load turbo run dev --filter ./apps/studio --",
    "studio:build": "pnpm env:load turbo run build --filter ./apps/studio --",
    "studio:start": "pnpm env:load turbo run start --filter ./apps/studio --",
    "site:dev": "pnpm env:load turbo run dev --filter ./apps/site --",
    "site:build": "pnpm env:load turbo run build --filter ./apps/site --",
    "site:start": "pnpm env:load turbo run start --filter ./apps/site --",
    "links:dev": "pnpm env:load turbo run dev --filter ./apps/links --",
    "links:build": "pnpm env:load turbo run build --filter ./apps/links --",
    "links:start": "pnpm env:load turbo run start --filter ./apps/links --",
    "db:generate": "turbo run db:generate --",
    "db:migrate": "turbo run db:migrate --",
    "db:studio": "turbo run db:studio --",
    "madge:circular": "pnpm dlx madge -c --extensions ts,tsx,js,jsx .",
    "storybook:clean": "turbo run clean --filter ./apps/storybook",
    "storybook:build": "turbo run build --filter ./apps/storybook",
    "storybook:serve": "turbo run serve --filter ./apps/storybook",
    "storybook:dev": "turbo run dev --filter ./apps/storybook",
    "icons:build": "turbo run build --filter ./packages/icons",
    "supabase:link": "supabase link --project-ref $SUPABASE_PROJECT_ID",
    "supabase:link:dev": "pnpm env:load pnpm supabase:link",
    "supabase:link:prod": "pnpm env:load pnpm supabase link"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.22.0",
    "@types/node": "^22.13.1",
    "@valguide/eslint-config": "workspace:*",
    "@valguide/test-config": "workspace:*",
    "@valguide/typescript-config": "workspace:*",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "turbo": "^2.2.3"
  },
  "engines": {
    "node": ">=18"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120
  },
  "packageManager": "pnpm@10.10.0",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "wallaby": {
    "trace": true
  }
}
