# Copy to .env.local for local development outside valguide-workspace.
# Keep real secrets out of git.

NODE_ENV=development
VITE_ENV=local

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/valguide_local

BETTER_AUTH_SECRET=replace-with-local-secret
BETTER_AUTH_DEV_OTP=000000
BETTER_AUTH_URL=https://studio.local.dev
BETTER_AUTH_TRUSTED_ORIGINS=https://studio.local.dev,https://app.local.dev
BETTER_AUTH_COOKIE_DOMAIN=.local.dev
BETTER_AUTH_COOKIE_PREFIX=valguide-local-auth

APP_BASE_URL=https://app.local.dev
LINKS_BASE_URL=https://links.local.dev
ADMIN_BASE_URL=https://admin.local.dev
ADMIN_AUTH_MODE=credentials
ADMIN_COOKIE_DOMAIN=admin.local.dev
ADMIN_ALLOWED_EMAILS=curator@museum-zurich.example
VITE_STUDIO_URL=https://studio.local.dev
VITE_APP_DOMAIN=app.local.dev
VITE_PRIVACY_POLICY_URL=https://www.example.com/privacy-policy
VITE_TERMS_OF_SERVICE_URL=https://www.example.com/terms-of-service
VITE_STUDIO_SUPPORT_EMAIL=support@example.com

EMAIL_FROM=ValGuide <noreply@example.com>
RESEND_SENDING_API_KEY=

VITE_POSTHOG_ENABLED=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

VITE_IMAGE_DELIVERY_PROVIDER=cloudflare
VITE_IMAGE_PROVIDER=cloudflare
VITE_ASSET_BASE_URL=
VITE_R2_PUBLIC_URL=https://assets.example.com

USERS_SLACK_CHANNEL=users-local
MAINTENANCE_SLACK_CHANNEL=maintenance-local
STUDIO_EVENTS_SLACK_CHANNEL=studio-events-local
STUDIO_FEEDBACK_SLACK_CHANNEL=studio-feedback-local
VALBOT_SLACK_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_TEAM_ID=

LINEAR_API_KEY=
LINEAR_FEEDBACK_TEAM_ID=
LINEAR_FEEDBACK_LABEL_ID=

DOCS_PASSWORD=replace-with-local-docs-password
STORYBOOK_PASSWORD=replace-with-local-storybook-password
