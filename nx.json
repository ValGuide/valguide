{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "defaultBase": "main",
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/.env*",
      { "env": "VITE_ENV" },
      { "env": "DATABASE_URL" },
      { "env": "DRIZZLE_LOG_ENABLED" },
      { "env": "VALBOT_SLACK_TOKEN" },
      { "env": "MAINTENANCE_SLACK_CHANNEL" },
      { "env": "USERS_SLACK_CHANNEL" },
      { "env": "STUDIO_EVENTS_SLACK_CHANNEL" },
      { "env": "STUDIO_FEEDBACK_SLACK_CHANNEL" },
      { "env": "STUDIO_PERFORMANCE_LOG_ENABLED" },
      { "env": "BETTER_AUTH_SECRET" },
      { "env": "BETTER_AUTH_URL" },
      { "env": "BETTER_AUTH_TRUSTED_ORIGINS" },
      { "env": "BETTER_AUTH_COOKIE_DOMAIN" },
      { "env": "BETTER_AUTH_COOKIE_PREFIX" },
      { "env": "BETTER_AUTH_DEV_OTP" },
      { "env": "RESEND_SENDING_API_KEY" },
      { "env": "VITE_POSTHOG_ENABLED" },
      { "env": "VITE_POSTHOG_KEY" },
      { "env": "VITE_POSTHOG_HOST" },
      { "env": "VITE_PRIVACY_POLICY_URL" },
      { "env": "VITE_IMAGEKIT_URL" },
      { "env": "VITE_STUDIO_URL" },
      { "env": "VITE_TERMS_OF_SERVICE_URL" },
      { "env": "VITE_APP_DOMAIN" },
      { "env": "DOCS_PASSWORD" },
      { "env": "ADMIN_ALLOWED_EMAILS" },
      { "env": "ADMIN_COOKIE_DOMAIN" },
      { "env": "ADMIN_BASE_URL" },
      { "env": "LINKS_BASE_URL" },
      { "env": "SLACK_CLIENT_ID" },
      { "env": "SLACK_CLIENT_SECRET" },
      { "env": "SLACK_TEAM_ID" },
      { "env": "VITE_STUDIO_SUPPORT_EMAIL" },
      { "env": "VITE_ASSET_BASE_URL" },
      { "env": "VITE_R2_PUBLIC_URL" },
      { "env": "VITE_IMAGE_DELIVERY_PROVIDER" },
      { "env": "VITE_IMAGE_PROVIDER" },
      { "env": "BLOCK_ROBOTS" },
      { "env": "MAINTENANCE_FORCE_STUDIO" },
      { "env": "MAINTENANCE_FORCE_APP" },
      { "env": "WRANGLER_REMOTE" },
      { "env": "LINEAR_API_KEY" },
      { "env": "LINEAR_FEEDBACK_TEAM_ID" },
      { "env": "LINEAR_FEEDBACK_LABEL_ID" },
      { "env": "LAUNCH_EDITOR" },
      { "env": "EDITOR" },
      { "env": "VISUAL" }
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default"]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/.next", "{projectRoot}/.output"]
    },
    "build:analyse": {
      "dependsOn": ["^build"],
      "cache": false,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/.next", "{projectRoot}/.output"]
    },
    "lint": {
      "cache": false
    },
    "type-check": {
      "cache": false
    },
    "i18n-check": {
      "inputs": ["{workspaceRoot}/packages/core/i18n/messages/*.json"]
    },
    "dev": {
      "cache": false,
      "continuous": true
    },
    "dev:remote": {
      "cache": false,
      "continuous": true
    },
    "preview": {
      "cache": false,
      "continuous": true
    },
    "serve": {
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "clean:vite": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:studio": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  }
}
