{
  "name": "@valguide/storybook",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "storybook dev -p 6006 --host 0.0.0.0 --no-open",
    "build": "storybook build",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:dev": "pnpm build && wrangler deploy --env dev",
    "worker:dev": "wrangler dev",
    "serve": "serve storybook-static",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf node_modules package-lock.json yarn.lock pnpm-lock.yaml storybook-static",
    "clean:vite": "rm -rf node_modules/.vite"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/storybook-static"
        ]
      },
      "dev": {
        "continuous": true,
        "cache": false
      },
      "type-check": {
        "cache": false
      },
      "serve": {
        "continuous": true,
        "outputs": []
      },
      "clean": {
        "cache": false
      },
      "clean:vite": {
        "cache": false
      }
    }
  },
  "dependencies": {
    "@tanstack/react-form": "^1.28.4",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.166.3",
    "@valguide/app": "workspace:*",
    "@valguide/core": "workspace:*",
    "@valguide/studio": "workspace:*",
    "@valguide/www": "workspace:*",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "use-intl": "^4.8.3"
  },
  "devDependencies": {
    "@storybook/addon-themes": "^10.2.16",
    "@storybook/react-vite": "^10.2.16",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "msw": "^2.12.3",
    "msw-storybook-addon": "^2.0.6",
    "serve": "^14.2.6",
    "storybook": "^10.2.16",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-tsconfig-paths": "^6.1.1",
    "wrangler": "^4.71.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
