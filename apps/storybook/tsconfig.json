{
  "extends": "@valguide/typescript-config/nextjs.json",
  "include": [
    "src",
    ".storybook/**/*.tsx",
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.css",
    "next.config.mjs"
  ],
  "exclude": [
    "dist",
    "build",
    "node_modules"
  ],
  "compilerOptions": {
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@valguide/visit/*": [
        "../apps/guide/*"
      ],
      "@valguide/studio/*": [
        "../apps/studio/*"
      ],
      "@valguide/landing/*": [
        "../apps/home/*"
      ],
      "@valguide/features/*": [
        "../../packages/core/features/*"
      ],
      "@valguide/ui/*": [
        "../../packages/core/ui/*"
      ],
      "@valguide/i18n/*": [
        "../../packages/core/i18n/*"
      ],
      "@valguide/core/*": [
        "../../packages/core/*"
      ],
      "@valguide/icons/*": [
        "../../packages/icons/dist/*"
      ],
      "@valguide/logger/*": [
        "../../packages/logger/src/*"
      ],
      "@valguide/logger": [
        "../../packages/logger"
      ]
    }
  }
}
