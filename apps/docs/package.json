{
  "name": "@valguide/docs",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev --port 3006",
    "build": "vite build",
    "dev:remote": "WRANGLER_REMOTE=true vite dev --port 3006",
    "preview": "vite preview --port 3006",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:dev": "CLOUDFLARE_ENV=dev pnpm build && wrangler deploy --env dev",
    "cf-typegen": "wrangler types",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "clean": "rm -rf node_modules package-lock.json yarn.lock pnpm-lock.yaml .turbo .wrangler",
    "clean:vite": "rm -rf node_modules/.vite",
    "type-check": "fumadocs-mdx && tsc --noEmit",
    "tail": "wrangler tail",
    "tail:dev": "wrangler tail --env dev"
  },
  "dependencies": {
    "@tanstack/react-router": "1.166.3",
    "@tanstack/react-start": "1.166.3",
    "fumadocs-core": "16.6.12",
    "fumadocs-mdx": "14.2.9",
    "fumadocs-ui": "16.6.12",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.2.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@valguide/typescript-config": "workspace:*",
    "@vitejs/plugin-react": "^5.1.3",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "wrangler": "^4.71.0"
  }
}
