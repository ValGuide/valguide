{
  "name": "@valguide/docs",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev --port 3006",
    "dev:local": "vite dev --port 3006 --host docs.local.dev",
    "build": "vite build",
    "preview": "vite preview --port 3006",
    "start": "PORT=3006 node .output/server/index.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "clean": "rm -rf node_modules package-lock.json yarn.lock pnpm-lock.yaml .turbo .output",
    "clean:vite": "rm -rf node_modules/.vite",
    "type-check": "fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@tanstack/react-router": "1.158.4",
    "@tanstack/react-start": "1.159.0",
    "fumadocs-core": "16.5.3",
    "fumadocs-mdx": "14.2.7",
    "fumadocs-ui": "16.5.3",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@valguide/typescript-config": "workspace:*",
    "@vitejs/plugin-react": "^5.1.3",
    "nitro": "3.0.1-alpha.1",
    "srvx": "^0.11.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.0.5"
  }
}
