{
  "extends": "@valguide/typescript-config/start.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@valguide/core/*": ["../../packages/core/*"],
      "fumadocs-mdx:collections/*": ["./.source/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/core/platform/providers/cloudflare/workers.d.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": ["node_modules"]
}
