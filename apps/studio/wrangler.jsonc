{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valguide-studio",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",

  // Production vars (studio.valguide.com)
  // process.env is auto-populated from vars+secrets (nodejs_compat + compat_date >= 2025-04-01)
  // Secrets set via: wrangler secret put <NAME>
  "vars": {
    "NODE_ENV": "production",
    "SUPABASE_URL": "https://iqqbsfadyyokridklekh.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "<public-supabase-publishable-key>",
    "SUPABASE_COOKIE_DOMAIN": ".valguide.com",
    "R2_ENDPOINT": "https://REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID.eu.r2.cloudflarestorage.com",
    "R2_BUCKET_NAME": "valguide-prod",
    "APP_BASE_URL": "https://app.valguide.com",
    "VITE_STUDIO_URL": "https://studio.valguide.com",
  },

  // Dev environment (studio.valguide.dev)
  // Deploy with: wrangler deploy --env dev
  // Set secrets with: wrangler secret put <NAME> --env dev
  "env": {
    "dev": {
      "vars": {
        "NODE_ENV": "production",
        "SUPABASE_URL": "https://zdmcpbqroqowlflvztks.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "<public-supabase-publishable-key>",
        "SUPABASE_COOKIE_DOMAIN": ".valguide.dev",
        "R2_ENDPOINT": "https://REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID.eu.r2.cloudflarestorage.com",
        "R2_BUCKET_NAME": "valguide-dev",
        "APP_BASE_URL": "https://app.valguide.dev",
        "VITE_STUDIO_URL": "https://studio.valguide.dev"
      }
    }
  }
}
