{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valguide-studio",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "placement": {
    // Neon is in Frankfurt, so bias Worker execution toward AWS eu-central-1.
    "region": "aws:eu-central-1"
  },

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },

  // Native R2 binding — no S3 API keys needed
  "r2_buckets": [{ "binding": "R2_BUCKET", "bucket_name": "valguide-prod", "jurisdiction": "eu" }],

  // KV namespaces:
  // - TOUR_DATA for published tour edge cache
  // - MAINTENANCE for global maintenance mode state
  "kv_namespaces": [
    { "binding": "TOUR_DATA", "id": "REPLACE_WITH_TOUR_DATA_KV_ID_PROD" },
    { "binding": "MAINTENANCE", "id": "REPLACE_WITH_MAINTENANCE_KV_ID_PROD" }
  ],

  // Production custom domain
  "routes": [{ "pattern": "studio.valguide.com", "custom_domain": true }],

  // Production vars (studio.valguide.com)
  // process.env is auto-populated from vars+secrets (nodejs_compat + compat_date >= 2025-04-01)
  // Secrets set via: wrangler secret put <NAME>
  "vars": {
    "NODE_ENV": "production",
    "USERS_SLACK_CHANNEL": "users",
    "STUDIO_FEEDBACK_SLACK_CHANNEL": "studio-feedback",
    "APP_BASE_URL": "https://app.valguide.com",
    "ADMIN_BASE_URL": "https://ops.val.guide",
    // Also needed at runtime by server functions (invite emails use serverEnv.VITE_STUDIO_URL)
    "VITE_STUDIO_URL": "https://studio.valguide.com",
    "BETTER_AUTH_URL": "https://studio.valguide.com",
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://studio.valguide.com,https://app.valguide.com",
    "BETTER_AUTH_COOKIE_DOMAIN": ".valguide.com",
    "BETTER_AUTH_COOKIE_PREFIX": "valguide-auth",
    "LINEAR_FEEDBACK_TEAM_ID": "REPLACE_WITH_LINEAR_FEEDBACK_TEAM_ID",
    "LINEAR_FEEDBACK_LABEL_ID": "REPLACE_WITH_LINEAR_FEEDBACK_LABEL_ID"
  },

  // Dev environment (studio.valguide.dev)
  // Build with: CLOUDFLARE_ENV=dev vite build
  // Deploy with: wrangler deploy (after building with CLOUDFLARE_ENV=dev)
  // Set secrets with: wrangler secret put <NAME> --env dev
  "env": {
    "dev": {
      "routes": [{ "pattern": "studio.valguide.dev", "custom_domain": true }],
      "r2_buckets": [{ "binding": "R2_BUCKET", "bucket_name": "valguide-dev", "jurisdiction": "eu" }],
      "kv_namespaces": [
        { "binding": "TOUR_DATA", "id": "REPLACE_WITH_TOUR_DATA_KV_ID_DEV" },
        { "binding": "MAINTENANCE", "id": "REPLACE_WITH_MAINTENANCE_KV_ID_DEV" }
      ],
      "vars": {
        "NODE_ENV": "production",
        "USERS_SLACK_CHANNEL": "users-dev",
        "STUDIO_FEEDBACK_SLACK_CHANNEL": "studio-feedback-dev",
        "APP_BASE_URL": "https://app.valguide.dev",
        "ADMIN_BASE_URL": "https://ops-dev.val.guide",
        // Also needed at runtime by server functions (invite emails use serverEnv.VITE_STUDIO_URL)
        "VITE_STUDIO_URL": "https://studio.valguide.dev",
        "BETTER_AUTH_URL": "https://studio.valguide.dev",
        "BETTER_AUTH_TRUSTED_ORIGINS": "https://studio.valguide.dev,https://app.valguide.dev",
        "BETTER_AUTH_COOKIE_DOMAIN": ".valguide.dev",
        "BETTER_AUTH_COOKIE_PREFIX": "valguide-dev-auth",
        "BLOCK_ROBOTS": "true",
        "LINEAR_FEEDBACK_TEAM_ID": "REPLACE_WITH_LINEAR_FEEDBACK_TEAM_ID",
        "LINEAR_FEEDBACK_LABEL_ID": "REPLACE_WITH_LINEAR_FEEDBACK_LABEL_ID"
      }
    }
  }
}
