{
  "extends": "@valguide/typescript-config/start.json",
  "compilerOptions": {
    "types": ["vite/client", "jest"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@valguide/features/*": ["../../packages/core/features/*"],
      "@valguide/slack/*": ["../../packages/core/slack/*"],
      "@valguide/ui/*": ["../../packages/core/ui/*"],
      "@valguide/supabase/*": ["../../packages/core/supabase/*"],
      "@valguide/i18n/*": ["../../packages/core/i18n/*"],
      "@valguide/core/*": ["../../packages/core/*"],
      "@valguide/icons/*": ["../../packages/icons/dist/*"],
      "@valguide/logger/*": ["../../packages/logger/src/*"],
      "@valguide/logger": ["../../packages/logger"]
    }
  },
  "include": ["next-env.d.ts", "next.config.mjs", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
