{
  "name": "@valguide/app",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:local": "vite dev --port 3000 --host app.local.dev",
    "dev:https": "pnpm dev:local & sleep 2 && caddy reverse-proxy --from https://app.local.dev --to localhost:3000 --internal-certs",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "start": "PORT=3000 node .output/server/index.mjs",
    "start:https": "PORT=3000 node .output/server/index.mjs & sleep 2 && caddy reverse-proxy --from https://app.local.dev --to localhost:3000 --internal-certs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "clean": "rm -rf node_modules package-lock.json yarn.lock pnpm-lock.yaml .turbo .output",
    "clean:vite": "rm -rf node_modules/.vite",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "ngrok": "ngrok http 3000"
  },
  "dependencies": {
    "@faker-js/faker": "^9.2.0",
    "@supabase/supabase-js": "^2.39.8",
    "@tanstack/react-devtools": "^0.9.0",
    "@tanstack/react-query": "^5.64.0",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@tanstack/react-router": "^1.145.7",
    "@tanstack/react-router-devtools": "^1.145.7",
    "@tanstack/react-router-ssr-query": "^1.145.7",
    "@tanstack/react-start": "^1.145.7",
    "@unpic/react": "^1.0.2",
    "@valguide/core": "workspace:*",
    "@valguide/transactional": "workspace:*",
    "@vercel/functions": "^3.3.6",
    "jest": "^29.7.0",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.2",
    "lucide-react": "0.546.0",
    "nanoid": "^5.1.6",
    "nitro": "3.0.1-alpha.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-leaflet": "^5.0.0",
    "usehooks-ts": "^3.1.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@storybook/react": "^10.0.8",
    "@tailwindcss/vite": "^4.1.16",
    "@tanstack/devtools-vite": "^0.4.0",
    "@types/jest": "^27.0.3",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^20.17.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@valguide/test-config": "workspace:*",
    "@valguide/typescript-config": "workspace:*",
    "@vercel/config": "^0.0.25",
    "@vitejs/plugin-react": "^5.0.4",
    "storybook": "^10.0.8",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.7.3",
    "vite": "^7.1.12",
    "vite-plugin-inspect": "^11.3.3",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
