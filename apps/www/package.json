{
  "name": "@valguide/www",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3004",
    "build": "vite build",
    "build:analyse": "ANALYZE=true vite build",
    "dev:remote": "WRANGLER_REMOTE=true vite dev --port 3004",
    "preview": "vite preview --port 3004",
    "deploy": "pnpm --dir ../.. wrangler-config generate www --target-env prod && pnpm build && wrangler deploy --config wrangler.generated.jsonc",
    "deploy:dev": "pnpm --dir ../.. wrangler-config generate www --target-env dev && CLOUDFLARE_ENV=dev pnpm build && wrangler deploy --config wrangler.generated.jsonc",
    "cf-typegen": "wrangler types",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "clean": "rm -rf node_modules package-lock.json yarn.lock pnpm-lock.yaml .output",
    "clean:vite": "rm -rf node_modules/.vite",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "ngrok": "ngrok http 3004",
    "tail": "wrangler tail",
    "tail:dev": "wrangler tail --env dev"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/.output"
        ]
      },
      "build:analyse": {
        "cache": false,
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/.output"
        ]
      },
      "dev": {
        "continuous": true,
        "cache": false
      },
      "dev:remote": {
        "continuous": true,
        "cache": false
      },
      "preview": {
        "continuous": true,
        "cache": false
      },
      "type-check": {
        "cache": false
      },
      "test": {
        "cache": false
      },
      "clean": {
        "cache": false
      },
      "clean:vite": {
        "cache": false
      }
    }
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.166.3",
    "@tanstack/react-router-ssr-query": "^1.166.3",
    "@tanstack/react-start": "^1.166.3",
    "@valguide/core": "workspace:*",
    "jest": "^29.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/devtools-vite": "^0.5.3",
    "@types/jest": "^27.0.3",
    "@types/node": "^20.17.17",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@valguide/typescript-config": "workspace:*",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.7.3",
    "vite": "^7.1.12",
    "vite-tsconfig-paths": "^6.1.1",
    "wrangler": "^4.71.0"
  }
}
