{
  "name": "@valguide/admin",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "vite build",
    "dev:remote": "WRANGLER_REMOTE=true vite dev --port 3001",
    "preview": "vite preview --port 3001",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:dev": "CLOUDFLARE_ENV=dev pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "clean": "rm -rf node_modules package-lock.json yarn.lock pnpm-lock.yaml .turbo .output",
    "clean:vite": "rm -rf node_modules/.vite",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "ngrok": "ngrok http 3001",
    "tail": "wrangler tail",
    "tail:dev": "wrangler tail --env dev"
  },
  "dependencies": {
    "@faker-js/faker": "^9.2.0",
    "@tanstack/react-devtools": "^0.9.0",
    "@tanstack/react-query": "^5.64.0",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@tanstack/react-router": "^1.153.2",
    "@tanstack/react-router-devtools": "^1.145.7",
    "@tanstack/react-router-ssr-query": "^1.145.7",
    "@tanstack/react-start": "^1.154.0",
    "@tanstack/react-table": "^8.21.3",

    "@valguide/core": "workspace:*",
    "@valguide/email": "workspace:*",
    "jest": "^29.7.0",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.2",
    "lucide-react": "0.546.0",
    "nanoid": "^5.1.6",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-leaflet": "^5.0.0",
    "usehooks-ts": "^3.1.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.25.2",
    "@storybook/react": "^10.0.8",
    "@tailwindcss/vite": "^4.1.16",
    "@tanstack/devtools-vite": "^0.4.0",
    "@types/jest": "^27.0.3",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^20.17.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@valguide/test-config": "workspace:*",
    "@valguide/typescript-config": "workspace:*",
    "@vitejs/plugin-react": "^5.0.4",
    "storybook": "^10.2.7",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.7.3",
    "vite": "^7.1.12",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "^4.67.0"
  }
}
