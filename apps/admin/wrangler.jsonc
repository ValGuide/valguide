{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valguide-admin",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "placement": {
    // Bias Worker execution toward Frankfurt-adjacent infrastructure.
    "region": "aws:eu-central-1"
  },

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },

  // Native R2 binding — for org logo uploads
  "r2_buckets": [{ "binding": "R2_BUCKET", "bucket_name": "valguide-prod", "jurisdiction": "eu" }],

  // KV namespaces:
  // - TOUR_DATA for published tour edge cache operations
  // - MAINTENANCE for maintenance mode state shared with app and studio
  "kv_namespaces": [
    { "binding": "TOUR_DATA", "id": "REPLACE_WITH_TOUR_DATA_KV_ID_PROD" },
    { "binding": "MAINTENANCE", "id": "REPLACE_WITH_MAINTENANCE_KV_ID_PROD" }
  ],

  // Production custom domain
  "routes": [{ "pattern": "ops.val.guide", "custom_domain": true }],

  // Production vars (ops.val.guide)
  // process.env is auto-populated from vars+secrets (nodejs_compat + compat_date >= 2025-04-01)
  // Secrets set via: wrangler secret put <NAME>
  "vars": {
    "NODE_ENV": "production",
    "VITE_ENV": "prod",
    "MAINTENANCE_SLACK_CHANNEL": "maintenance",
    "USERS_SLACK_CHANNEL": "users",
    "STUDIO_EVENTS_SLACK_CHANNEL": "studio-events",
    "BETTER_AUTH_URL": "https://ops.val.guide",
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://ops.val.guide",
    "ADMIN_COOKIE_DOMAIN": "ops.val.guide",
    "ADMIN_BASE_URL": "https://ops.val.guide",
    "ADMIN_ALLOWED_EMAILS": "curator@museum-zurich.example,curator@museum-zurich.example,ops@museum-zurich.example"
  },

  // Dev environment (ops-dev.val.guide)
  // Build with: CLOUDFLARE_ENV=dev vite build
  // Deploy with: wrangler deploy (after building with CLOUDFLARE_ENV=dev)
  // Set secrets with: wrangler secret put <NAME> --env dev
  "env": {
    "dev": {
      "routes": [{ "pattern": "ops-dev.val.guide", "custom_domain": true }],
      "r2_buckets": [{ "binding": "R2_BUCKET", "bucket_name": "valguide-dev", "jurisdiction": "eu" }],
      "kv_namespaces": [
        { "binding": "TOUR_DATA", "id": "REPLACE_WITH_TOUR_DATA_KV_ID_DEV" },
        { "binding": "MAINTENANCE", "id": "REPLACE_WITH_MAINTENANCE_KV_ID_DEV" }
      ],
      "vars": {
        "NODE_ENV": "production",
        "VITE_ENV": "dev",
        "MAINTENANCE_SLACK_CHANNEL": "maintenance-dev",
        "USERS_SLACK_CHANNEL": "users-dev",
        "STUDIO_EVENTS_SLACK_CHANNEL": "studio-events-dev",
        "BETTER_AUTH_URL": "https://ops-dev.val.guide",
        "BETTER_AUTH_TRUSTED_ORIGINS": "https://ops-dev.val.guide",
        "ADMIN_COOKIE_DOMAIN": "ops-dev.val.guide",
        "ADMIN_BASE_URL": "https://ops-dev.val.guide",
        "ADMIN_ALLOWED_EMAILS": "curator@museum-zurich.example,curator@museum-zurich.example,ops@museum-zurich.example",
        "BLOCK_ROBOTS": "true"
      }
    }
  }
}
