{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valguide-admin",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "placement": {
    // Bias Worker execution toward Frankfurt-adjacent infrastructure.
    "region": "aws:eu-central-1"
  },

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },

  "secrets": {
    "required": ["ADMIN_ALLOWED_EMAILS"]
  },

  // Shared Cloudflare resources are managed outside this public repo.
  // Keep these bucket names and binding IDs aligned with OpenTofu outputs instead of one-off setup scripts.
  // Native R2 binding — for org logo uploads
  "r2_buckets": [{ "binding": "R2_BUCKET", "bucket_name": "valguide-prod", "jurisdiction": "eu" }],

  // KV namespaces:
  // - AUTH_KV for Better Auth secondary storage (sessions, verifications, rate limits)
  // - TOUR_DATA for published tour edge cache operations
  // - MAINTENANCE for maintenance mode state shared with app and studio
  "kv_namespaces": [
    { "binding": "AUTH_KV", "id": "REPLACE_WITH_AUTH_KV_ID_PROD" },
    { "binding": "TOUR_DATA", "id": "REPLACE_WITH_TOUR_DATA_KV_ID_PROD" },
    { "binding": "MAINTENANCE", "id": "REPLACE_WITH_MAINTENANCE_KV_ID_PROD" }
  ],

  // Production custom domain
  "routes": [{ "pattern": "admin.example.com", "custom_domain": true }],

  // Production vars (admin.example.com)
  // process.env is auto-populated from vars+secrets (nodejs_compat + compat_date >= 2025-04-01)
  // Secrets set via: wrangler secret put <NAME>
  "vars": {
    "NODE_ENV": "production",
    "VITE_ENV": "prod",
    "MAINTENANCE_SLACK_CHANNEL": "maintenance",
    "USERS_SLACK_CHANNEL": "users",
    "STUDIO_EVENTS_SLACK_CHANNEL": "studio-events",
    "BETTER_AUTH_URL": "https://admin.example.com",
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://admin.example.com",
    "ADMIN_COOKIE_DOMAIN": "admin.example.com",
    "ADMIN_BASE_URL": "https://admin.example.com",
    "VITE_PRIVACY_POLICY_URL": "https://www.valguide.com/privacy-policy",
    "VITE_TERMS_OF_SERVICE_URL": "https://www.valguide.com/terms-of-service"
  },

  // Dev environment (admin-dev.example.com)
  // Build with: CLOUDFLARE_ENV=dev vite build
  // Deploy with: wrangler deploy (after building with CLOUDFLARE_ENV=dev)
  // Set secrets with: wrangler secret put <NAME> --env dev
  "env": {
    "dev": {
      "routes": [{ "pattern": "admin-dev.example.com", "custom_domain": true }],
      "r2_buckets": [{ "binding": "R2_BUCKET", "bucket_name": "valguide-dev", "jurisdiction": "eu" }],
      "kv_namespaces": [
        { "binding": "AUTH_KV", "id": "REPLACE_WITH_AUTH_KV_ID_DEV" },
        { "binding": "TOUR_DATA", "id": "REPLACE_WITH_TOUR_DATA_KV_ID_DEV" },
        { "binding": "MAINTENANCE", "id": "REPLACE_WITH_MAINTENANCE_KV_ID_DEV" }
      ],
      "secrets": {
        "required": ["ADMIN_ALLOWED_EMAILS"]
      },
      "vars": {
        "NODE_ENV": "production",
        "VITE_ENV": "dev",
        "MAINTENANCE_SLACK_CHANNEL": "maintenance-dev",
        "USERS_SLACK_CHANNEL": "users-dev",
        "STUDIO_EVENTS_SLACK_CHANNEL": "studio-events-dev",
        "BETTER_AUTH_URL": "https://admin-dev.example.com",
        "BETTER_AUTH_TRUSTED_ORIGINS": "https://admin-dev.example.com",
        "ADMIN_COOKIE_DOMAIN": "admin-dev.example.com",
        "ADMIN_BASE_URL": "https://admin-dev.example.com",
        "VITE_PRIVACY_POLICY_URL": "https://www.valguide.dev/privacy-policy",
        "VITE_TERMS_OF_SERVICE_URL": "https://www.valguide.dev/terms-of-service",
        "BLOCK_ROBOTS": "true"
      }
    }
  }
}
